# Google Ads API — real secrets, never committed. Copy to .env and fill in.
#
#   npm run ads:auth      mints GOOGLE_ADS_REFRESH_TOKEN and writes it here
#
# Developer token: Ads manager account 434-363-4049 → Tools & Settings →
# Setup → API Center. Basic Access, 15,000 operations/day.
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth 2.0 client of type "Desktop app", from Cloud project ko-ads-api
# (41808878114) → APIs & Services → Credentials.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Written by npm run ads:auth. Do not paste this anywhere.
GOOGLE_ADS_REFRESH_TOKEN=

# The manager account every call is made through.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=4343634049

# Site assistant (OpenAI). A real secret — set it on the Worker, never commit:
#   npx wrangler secret put OPENAI_API_KEY
OPENAI_API_KEY=

# Sigmafy lead ingest. Without these the contact form still emails, but the
# lead never reaches the CRM — silently, via a console.error nobody reads.
SIGMAFY_LEADS_URL=
SIGMAFY_INGEST_TOKEN=

# Production-only protection for /internal/*. If either value is missing in a
# production build, those routes return 404 rather than becoming public.
INTERNAL_ACCESS_USERNAME=
INTERNAL_ACCESS_PASSWORD=

# Analytics, mint with npm run ga:auth. Written here rather than kept in a
# shell: the Admin API is how the property estate gets audited, and 58
# properties across 3 accounts is not something to hold in your head.
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# GA4 measurement id for the *public* site. This is a build-time public value,
# so it belongs in .env.production (tracked) next to the Ads ids, not here.
# Unset, Analytics.tsx renders nothing and the site loads no third-party
# script at all — which is how www.2ko.co.za came to report nowhere while a
# property sat waiting for it.
#   NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
