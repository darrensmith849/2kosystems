# =====================================================================
# 2KO Systems — Environment variables (keys only, NEVER add values here)
# Copy to .env.local for local development; configure in Vercel project
# settings for production / preview.
# =====================================================================

# --- Public site ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Existing admin (/admin/agent + new /admin/ops shared session) -------
# Single shared password. Gates both consoles. Rotate via Vercel UI.
AGENT_ADMIN_UI_PASSWORD=

# Service-to-service API key for /api/v1/* — legacy, not used by /admin/ops.
AGENT_ADMIN_API_KEY=

# --- Existing email / chat services --------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_LIST_ID=
BOOK_AUDIT_TO_EMAIL=
# Recipient for the daily ops renewals digest (cron: /api/cron/renewals-remind).
# Falls back to BREVO_SENDER_EMAIL if unset. Leave blank to suppress the send
# (cron still runs, computes counts, writes audit — just no email).
BREVO_OPS_DIGEST_TO=
NANO_API_KEY=
PEXELS_API_KEY=

# --- Client onboarding questionnaire (/q/[token]) ------------------------
# Shared password a client enters to unlock the onboarding form (e.g.
# systems123!). Separate from the admin password above.
QUESTIONNAIRE_PASSWORD=
# Comma-separated internal addresses cc'd on every SLA email. Leave blank for
# now; add the team addresses once they exist, e.g.:
# SLA_CC_EMAILS=darren@2ko.co.za,peter777daniel@gmail.com
SLA_CC_EMAILS=
# Set to 1 to log the SLA email payload and SKIP actually sending (local
# testing without spamming). Uses BREVO_API_KEY/BREVO_SENDER_EMAIL when unset.
SLA_EMAIL_DRYRUN=

# =====================================================================
# /admin/ops dashboard — Phase 1 additions
# =====================================================================

# --- Database (Postgres) -------------------------------------------------
# DATABASE_URL is read by the runtime client (pooled connection).
# DATABASE_URL_DIRECT is used by drizzle-kit for migrations only.
# If unset, /admin/ops renders in skeleton mode and all mutations return 503.
DATABASE_URL=
DATABASE_URL_DIRECT=

# ---- LOCAL DEV ONLY (uses docker-compose.ops.yml) ----
# Uncomment the two lines below in your .env.local to point the app at the
# disposable Postgres container started by `docker compose -f
# docker-compose.ops.yml up -d`. See docs/runbooks/ops-local-dev.md.
# DO NOT use these credentials in production.
# DATABASE_URL=postgres://ops_dev:ops_dev_local_only_do_not_use_in_prod@localhost:5433/ops_dev
# DATABASE_URL_DIRECT=postgres://ops_dev:ops_dev_local_only_do_not_use_in_prod@localhost:5433/ops_dev

# --- Integrations (all read-only in Phase 1) -----------------------------
# GitHub: personal access token, scopes `read:user`, `repo`.
GITHUB_TOKEN=
GH_TOKEN=

# Vercel: read-only token. Both teams (pumpbots-projects + impart-global)
# are pulled by the same token via the multi-team API.
VERCEL_API_TOKEN=

# Cloudflare: token scoped to Account Read, Zone Read, DNS Read,
# Pages Read, Account Analytics Read. Account ID also required.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Hetzner Cloud: read-only token.
HETZNER_API_TOKEN=

# Better Stack (Phase 1 webhook target — wired in Phase 2):
BETTERSTACK_WEBHOOK_SECRET=

# --- Runtime portability -------------------------------------------------
# Cron handlers require this header to match. Vercel Cron passes it.
# A future Hetzner systemd timer would `curl -H "X-Cron-Secret: $CRON_SECRET"`.
CRON_SECRET=

# Set OPS_RUNTIME=hetzner if/when the dashboard moves off Vercel onto
# a Hetzner Node host. Leave unset on Vercel — VERCEL=1 is set automatically.
OPS_RUNTIME=
OPS_PUBLIC_URL=
OPS_REGION=
